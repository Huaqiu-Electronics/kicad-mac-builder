2026-07-23T11:04:07.7346220Z     return 1
2026-07-23T11:04:07.7365740Z   fi
2026-07-23T11:04:07.7366030Z 
2026-07-23T11:04:07.7366280Z   local -a SUDO=("/usr/bin/sudo")
2026-07-23T11:04:07.7366870Z   if [[ -n "${SUDO_ASKPASS-}" ]]
2026-07-23T11:04:07.7367360Z   then
2026-07-23T11:04:07.7367710Z     SUDO+=("-A")
2026-07-23T11:04:07.7368140Z   elif [[ -n "${NONINTERACTIVE-}" ]]
2026-07-23T11:04:07.7368810Z   then
2026-07-23T11:04:07.7368950Z     SUDO+=("-n")
2026-07-23T11:04:07.7369080Z   fi
2026-07-23T11:04:07.7369810Z 
2026-07-23T11:04:07.7369890Z   if [[ -z "${HAVE_SUDO_ACCESS-}" ]]
2026-07-23T11:04:07.7370130Z   then
2026-07-23T11:04:07.7370270Z     if [[ -n "${NONINTERACTIVE-}" ]]
2026-07-23T11:04:07.7370450Z     then
2026-07-23T11:04:07.7370590Z       "${SUDO[@]}" -l mkdir &>/dev/null
2026-07-23T11:04:07.7370770Z     else
2026-07-23T11:04:07.7371510Z       "${SUDO[@]}" -v && "${SUDO[@]}" -l mkdir &>/dev/null
2026-07-23T11:04:07.7372280Z     fi
2026-07-23T11:04:07.7372430Z     HAVE_SUDO_ACCESS="$?"
2026-07-23T11:04:07.7372610Z   fi
2026-07-23T11:04:07.7372680Z 
2026-07-23T11:04:07.7372810Z   if [[ -n "${HOMEBREW_ON_MACOS-}" ]] && [[ "${HAVE_SUDO_ACCESS}" -ne 0 ]]
2026-07-23T11:04:07.7373110Z   then
2026-07-23T11:04:07.7373430Z     abort "Need sudo access on macOS (e.g. the user ${USER} needs to be an Administrator)!"
2026-07-23T11:04:07.7373740Z   fi
2026-07-23T11:04:07.7373810Z 
2026-07-23T11:04:07.7374260Z   return "${HAVE_SUDO_ACCESS}"
2026-07-23T11:04:07.7374520Z }
