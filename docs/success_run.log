2026-07-23T11:04:07.7376440Z     do
2026-07-23T11:04:07.7376800Z       warn "$(printf "Trying again in %d seconds: %s" "${pause}" "$(shell_join "$@")")"
2026-07-23T11:04:07.7377110Z       sleep "${pause}"
2026-07-23T11:04:07.7377280Z       ((pause *= 2))
2026-07-23T11:04:07.7377500Z       if "$@"
2026-07-23T11:04:07.7377660Z       then
2026-07-23T11:04:07.7377790Z         return
2026-07-23T11:04:07.7377940Z       fi
2026-07-23T11:04:07.7378080Z     done
2026-07-23T11:04:07.7378320Z     abort "$(printf "Failed %d times doing: %s" "${tries}" "$(shell_join "$@")")"
2026-07-23T11:04:07.7378610Z   fi
2026-07-23T11:04:07.7378720Z }
2026-07-23T11:04:07.7378790Z 
2026-07-23T11:04:07.7378840Z execute_sudo() {
